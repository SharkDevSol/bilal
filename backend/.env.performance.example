# Performance Testing Environment Variables
# Copy this file to .env.performance and update with your values

# API Configuration
BASE_URL=http://localhost:5000
BRANCH_CODE=AAS

# Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Teacher User Credentials
TEACHER_USERNAME=teacher1
TEACHER_PASSWORD=teacher123

# Student User Credentials
STUDENT_USERNAME=student1
STUDENT_PASSWORD=student123

# Guardian User Credentials (optional)
GUARDIAN_USERNAME=guardian1
GUARDIAN_PASSWORD=guardian123

# Test Configuration
TEST_DURATION=30s
TEST_VUS=10

# Optional: k6 Cloud Configuration
# K6_CLOUD_TOKEN=your_cloud_token_here
# K6_CLOUD_PROJECT_ID=your_project_id_here
